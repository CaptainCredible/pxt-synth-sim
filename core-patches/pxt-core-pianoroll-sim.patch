diff --git a/pxtblocks/fields/field_preset_values.ts b/pxtblocks/fields/field_preset_values.ts
new file mode 100644
index 0000000..c4578e1
--- /dev/null
+++ b/pxtblocks/fields/field_preset_values.ts
@@ -0,0 +1,140 @@
+import * as Blockly from "blockly";
+import { FieldDropdown } from "./field_dropdown";
+import { FieldCustom, FieldCustomDropdownOptions } from "./field_utils";
+
+/**
+ * An enum dropdown whose members carry values for the other inputs of the same block.
+ * Choosing a member in the menu copies those values into the block, so presets cost
+ * nothing at runtime: the program only contains whatever is on the block.
+ *
+ *     enum SynthSoundPreset {
+ *         //% block="custom"
+ *         Custom = 0,
+ *         //% block="FM pluck"
+ *         //% blockValues="osc1Shape=oscShapes.triangle osc1Level=100 attack=0 ..."
+ *         FMPluck = 1,
+ *     }
+ *
+ *     //% soundPreset.fieldEditor="presetvalues"
+ *     export function setUpSound(preset: SynthPreset, soundPreset: SynthSoundPreset, ...)
+ *
+ * blockValues is a space separated list of name=value. A name matching a field on the block
+ * (e.g. an enum dropdown) gets the value as the field value; otherwise the number goes into the
+ * shadow number/slider block of the input with that name. Values are only applied when the user
+ * picks a member, never when a project loads.
+ *
+ * When the user then changes one of the values the preset filled in, the dropdown switches
+ * back to the first member without blockValues (e.g. "custom"), so it never claims a preset
+ * that isn't on the block any more.
+ */
+export class FieldPresetValues extends FieldDropdown implements FieldCustom {
+    public isFieldCustom_ = true;
+    protected blocksInfo: pxtc.BlocksInfo;
+    protected customValue: string;
+    /** event group of our own last fill-in, so its changes don't count as user edits */
+    protected applyGroup: string;
+    protected changeListener: (e: Blockly.Events.Abstract) => void;
+
+    constructor(text: string, params: FieldCustomDropdownOptions, validator?: Blockly.FieldValidator) {
+        const options = ((params.data || []) as any[]).map(o => [o[0], o[1]] as [string, string]);
+        super(options.length ? options : [["", ""]], validator);
+        this.blocksInfo = params.blocksInfo;
+        this.customValue = options.find(o => !this.presetValues(o[1]))?.[1];
+        if (options.some(o => o[1] === text)) this.setValue(text);
+    }
+
+    initView() {
+        super.initView();
+        const ws = this.sourceBlock_?.workspace;
+        if (ws && !this.changeListener) {
+            this.changeListener = e => this.onWorkspaceChange(e);
+            ws.addChangeListener(this.changeListener);
+        }
+    }
+
+    dispose() {
+        const ws = this.sourceBlock_?.workspace;
+        if (ws && this.changeListener) ws.removeChangeListener(this.changeListener);
+        this.changeListener = undefined;
+        super.dispose();
+    }
+
+    protected presetValues(qName: string): string | undefined {
+        // custom attributes are kept as strings on the symbol's attributes
+        return (this.blocksInfo?.apis?.byQName?.[qName]?.attributes as any)?.blockValues as string;
+    }
+
+    /** the names (fields or inputs of this block) that the current preset sets */
+    protected presetNames(): string[] {
+        const values = this.presetValues(this.getValue());
+        if (!values) return [];
+        return values.trim().split(/\s+/).map(pair => pair.slice(0, pair.indexOf("="))).filter(n => !!n);
+    }
+
+    protected onWorkspaceChange(e: Blockly.Events.Abstract) {
+        const block = this.sourceBlock_;
+        if (!block || e.type !== Blockly.Events.BLOCK_CHANGE) return;
+        if (this.customValue === undefined || this.getValue() === this.customValue) return;
+        if (e.group && e.group === this.applyGroup) return;
+
+        const change = e as Blockly.Events.BlockChange;
+        if (change.element !== "field" || change.oldValue === change.newValue) return;
+
+        const names = this.presetNames();
+        let changedName: string | undefined;
+        if (change.blockId === block.id) {
+            changedName = change.name;
+        }
+        else {
+            // a number/slider shadow plugged into one of our inputs
+            const changed = block.workspace.getBlockById(change.blockId);
+            const input = changed && changed.getParent() === block ? block.getInputWithBlock(changed) : undefined;
+            changedName = input?.name;
+        }
+        if (changedName && changedName !== this.name && names.indexOf(changedName) >= 0) {
+            this.setValue(this.customValue);
+        }
+    }
+
+    protected onItemSelected_(menu: Blockly.Menu, menuItem: Blockly.MenuItem) {
+        super.onItemSelected_(menu, menuItem);
+        this.applyPreset(this.getValue());
+    }
+
+    protected applyPreset(qName: string) {
+        const block = this.sourceBlock_;
+        const values = this.presetValues(qName);
+        if (!block || !values) return;
+
+        // one undo step for the whole preset
+        const group = Blockly.Events.getGroup();
+        if (!group) Blockly.Events.setGroup(true);
+        this.applyGroup = Blockly.Events.getGroup();
+        try {
+            for (const pair of values.trim().split(/\s+/)) {
+                const eq = pair.indexOf("=");
+                if (eq <= 0) continue;
+                const name = pair.slice(0, eq);
+                const value = pair.slice(eq + 1);
+
+                const field = block.getField(name);
+                if (field && field !== this) {
+                    field.setValue(value);
+                    continue;
+                }
+
+                const target = block.getInputTargetBlock(name);
+                if (!target) continue;
+                for (const fieldName of ["SLIDER", "NUM"]) {
+                    if (target.getField(fieldName)) {
+                        target.setFieldValue(value, fieldName);
+                        break;
+                    }
+                }
+            }
+        }
+        finally {
+            if (!group) Blockly.Events.setGroup(false);
+        }
+    }
+}
diff --git a/pxtblocks/fields/field_row_separator.ts b/pxtblocks/fields/field_row_separator.ts
new file mode 100644
index 0000000..9d289bf
--- /dev/null
+++ b/pxtblocks/fields/field_row_separator.ts
@@ -0,0 +1,84 @@
+import * as Blockly from "blockly";
+
+/**
+ * A horizontal line across the whole block, used between the sections of an
+ * expandable block (see the expandableArgumentSeparators block attribute).
+ *
+ * The field itself is tiny so it never affects the block's width; the line is drawn
+ * outside its bounds, from the block's left edge to its right edge, and re-measured
+ * after the block is rendered (and whenever the workspace changes).
+ */
+export class FieldRowSeparator extends Blockly.Field<string> {
+    public SERIALIZABLE = false;
+    public EDITABLE = false;
+
+    protected line: SVGLineElement;
+    protected changeListener: (e: Blockly.Events.Abstract) => void;
+    protected pending = false;
+
+    constructor() {
+        super("");
+        this.size_ = new Blockly.utils.Size(1, 10);
+    }
+
+    initView() {
+        this.line = Blockly.utils.dom.createSvgElement("line", {
+            "stroke-width": 5,
+            "stroke-linecap": "round",
+            "pointer-events": "none"
+        }, this.fieldGroup_) as SVGLineElement;
+
+        const ws = this.sourceBlock_?.workspace;
+        if (ws) {
+            this.changeListener = () => this.scheduleUpdate();
+            ws.addChangeListener(this.changeListener);
+        }
+    }
+
+    dispose() {
+        const ws = this.sourceBlock_?.workspace;
+        if (ws && this.changeListener) ws.removeChangeListener(this.changeListener);
+        this.changeListener = undefined;
+        super.dispose();
+    }
+
+    protected render_() {
+        this.size_.width = 1;
+        this.size_.height = 10;
+        this.scheduleUpdate();
+    }
+
+    protected scheduleUpdate() {
+        if (this.pending) return;
+        this.pending = true;
+        requestAnimationFrame(() => {
+            this.pending = false;
+            this.updateLine();
+        });
+    }
+
+    protected updateLine() {
+        const block = this.sourceBlock_ as Blockly.BlockSvg;
+        if (!this.line || !block || !this.fieldGroup_) return;
+
+        // the field group is translated relative to the block's own group
+        const transform = this.fieldGroup_.transform?.baseVal?.consolidate?.();
+        const offsetX = transform ? transform.matrix.e : 0;
+        const width = block.width || 0;
+        const inset = 26;
+
+        this.line.setAttribute("x1", String(inset - offsetX));
+        this.line.setAttribute("x2", String(Math.max(inset, width - inset) - offsetX));
+        this.line.setAttribute("y1", "5");
+        this.line.setAttribute("y2", "5");
+        // a somewhat darker shade of the block colour (darker green on a green block)
+        const colour = block.getColour?.() || "#000000";
+        const dark = Blockly.utils.colour.blend("#000000", colour, 0.15) || colour;
+        this.line.setAttribute("stroke", dark);
+        this.line.setAttribute("stroke-opacity", "0.9");
+    }
+
+    getText_(): string {
+        return "";
+    }
+}
diff --git a/pxtblocks/fields/field_synth_graph.ts b/pxtblocks/fields/field_synth_graph.ts
new file mode 100644
index 0000000..96a4d96
--- /dev/null
+++ b/pxtblocks/fields/field_synth_graph.ts
@@ -0,0 +1,454 @@
+/// <reference path="../../built/pxtlib.d.ts" />
+
+import * as Blockly from "blockly";
+import { FieldCustom, FieldCustomDropdownOptions, postSimulatorMessage } from "./field_utils";
+import { FieldDropdown } from "./field_dropdown";
+
+/**
+ * A field for an enum parameter that draws a small live graph instead of a dropdown.
+ * Clicking it steps to the next enum value. The graph also reads the current values
+ * of sibling number inputs on the same block, so it updates as you change them.
+ *
+ *     //% osc1Shape.fieldEditor="synthgraph"
+ *     //% osc1Shape.fieldOptions.graph="wave"        wave | envelope | filter | lfo
+ *     //% osc1Shape.fieldOptions.inputs="pw1"         sibling input names, in the order the graph expects
+ *     //% osc1Shape.fieldOptions.defaults="50"        used when an input is hidden or not a number
+ *
+ * graph="wave"     inputs: pulse width (0-100, 50 = square)
+ * graph="envelope" inputs: attack ms, decay ms, sustain (0-100), release ms
+ * graph="filter"   inputs: cutoff (0-100), resonance (0-100)
+ * graph="lfo"      inputs: frequency in Hz
+ *
+ * The enum value decides the shape: names containing saw/pulse/triangle, gate/envelope,
+ * low/high/band (for lowpass, highpass, bandpass).
+ */
+
+type GraphKind = "wave" | "envelope" | "filter" | "lfo";
+
+interface FieldSynthGraphOptions extends FieldCustomDropdownOptions {
+    graph?: GraphKind;
+    inputs?: string;
+    defaults?: string;
+}
+
+const SIZES: { [K in GraphKind]: [number, number] } = {
+    wave: [72, 34],
+    envelope: [150, 54],
+    filter: [150, 54],
+    lfo: [150, 40]
+};
+
+const SVG_NS = "http://www.w3.org/2000/svg";
+
+export class FieldSynthGraph extends Blockly.Field<string> implements FieldCustom {
+    public isFieldCustom_ = true;
+    public SERIALIZABLE = true;
+    public EDITABLE = true;
+    public CURSOR = "pointer";
+
+    protected options: [string, string][];
+    protected kind: GraphKind;
+    protected inputNames: string[];
+    protected inputDefaults: number[];
+    protected graphGroup: SVGGElement;
+    protected changeListener: (e: Blockly.Events.Abstract) => void;
+    protected lastKey: string;
+
+    constructor(text: string, params: FieldSynthGraphOptions, validator?: Blockly.FieldValidator) {
+        super(Blockly.Field.SKIP_SETUP);
+
+        this.options = ((params.data || []) as any[]).map(o => [typeof o[0] === "string" ? o[0] : (o[0]?.alt || o[1]), o[1]] as [string, string]);
+        this.kind = (params.graph || "wave") as GraphKind;
+        if (!SIZES[this.kind]) this.kind = "wave";
+        this.inputNames = (params.inputs || "").split(",").map(s => s.trim()).filter(s => !!s);
+        this.inputDefaults = (params.defaults || "").split(",").map(s => parseFloat(s));
+
+        const [w, h] = SIZES[this.kind];
+        this.size_ = new Blockly.utils.Size(w, h);
+
+        const initial = this.options.some(o => o[1] === text) ? text : this.options[0]?.[1];
+        this.setValue(initial);
+        if (validator) this.setValidator(validator);
+    }
+
+    protected doClassValidation_(newValue?: any): string | null {
+        if (typeof newValue !== "string") return null;
+        return this.options.some(o => o[1] === newValue) ? newValue : null;
+    }
+
+    getText_(): string {
+        const option = this.options.find(o => o[1] === this.getValue());
+        return option ? option[0] : "";
+    }
+
+    getFieldDescription(): string {
+        return this.getText_();
+    }
+
+    initView() {
+        this.graphGroup = Blockly.utils.dom.createSvgElement("g", {}, this.fieldGroup_) as SVGGElement;
+
+        const ws = this.sourceBlock_?.workspace;
+        if (ws) {
+            this.changeListener = (e: Blockly.Events.Abstract) => {
+                if (e.isUiEvent) return;
+                this.drawGraph();
+            };
+            ws.addChangeListener(this.changeListener);
+        }
+    }
+
+    dispose() {
+        const ws = this.sourceBlock_?.workspace;
+        if (ws && this.changeListener) ws.removeChangeListener(this.changeListener);
+        this.changeListener = undefined;
+        super.dispose();
+    }
+
+    protected render_() {
+        const [w, h] = SIZES[this.kind];
+        this.size_.width = w;
+        this.size_.height = h;
+        this.lastKey = undefined;
+        this.drawGraph();
+    }
+
+    protected showEditor_() {
+        if (!this.options.length) return;
+        const index = this.options.findIndex(o => o[1] === this.getValue());
+        this.setValue(this.options[(index + 1) % this.options.length][1]);
+    }
+
+    // ---------- reading sibling inputs ----------
+
+    protected readInputs(): number[] {
+        return this.inputNames.map((name, i) => {
+            const defl = isNaN(this.inputDefaults[i]) ? 0 : this.inputDefaults[i];
+            const target = this.sourceBlock_?.getInputTargetBlock(name);
+            if (!target) return defl;
+            for (const fieldName of ["SLIDER", "NUM"]) {
+                const field = target.getField(fieldName);
+                if (field) {
+                    const v = parseFloat(field.getValue() as any);
+                    return isNaN(v) ? defl : v;
+                }
+            }
+            return defl;
+        });
+    }
+
+    // ---------- drawing ----------
+
+    protected drawGraph() {
+        if (!this.graphGroup) return;
+        // only the enum member decides the shape ("gateOrEnv.ebvelope" -> "ebvelope")
+        const value = (this.getValue() || "").split(".").pop().toLowerCase();
+        const inputs = this.readInputs();
+        const key = value + "|" + inputs.join(",");
+        if (key === this.lastKey) return;
+        this.lastKey = key;
+
+        while (this.graphGroup.firstChild) this.graphGroup.removeChild(this.graphGroup.firstChild);
+        const [w, h] = SIZES[this.kind];
+
+        // the background is the click target (everything drawn on top ignores the pointer)
+        const bg = this.el("rect", { x: 0, y: 0, width: w, height: h, rx: 4, ry: 4, fill: "rgba(0,0,0,0.28)", stroke: "rgba(255,255,255,0.5)", "stroke-width": 1 });
+        bg.setAttribute("pointer-events", "all");
+        bg.setAttribute("cursor", "pointer");
+
+        switch (this.kind) {
+            case "wave": this.drawWave(value, inputs, w, h); break;
+            case "envelope": this.drawEnvelope(value, inputs, w, h); break;
+            case "filter": this.drawFilter(value, inputs, w, h); break;
+            case "lfo": this.drawLfo(value, inputs, w, h); break;
+        }
+    }
+
+    protected drawWave(value: string, inputs: number[], w: number, h: number) {
+        const pad = 5;
+        const top = pad + 2, bottom = h - pad, cycles = 2;
+        const cw = (w - pad * 2) / cycles;
+        const duty = clamp((inputs[0] ?? 50) / 100, 0.05, 0.95);
+        const shape = waveShape(value);
+        const pts: number[][] = [];
+        for (let c = 0; c < cycles; c++) {
+            const x0 = pad + c * cw;
+            if (shape === "pulse") {
+                pts.push([x0, top], [x0 + cw * duty, top], [x0 + cw * duty, bottom], [x0 + cw, bottom]);
+                if (c < cycles - 1) pts.push([x0 + cw, top]);
+            }
+            else if (shape === "triangle") {
+                pts.push([x0, bottom], [x0 + cw / 2, top], [x0 + cw, bottom]);
+            }
+            else {
