+            x: 20, y: h / 2 + 4, fill: "#333333", "font-size": 11, "font-family": "sans-serif", "font-weight": "bold",
+            "pointer-events": "none"
+        }, g);
+        label.setAttribute("style", "fill: #333333;"); // see label(): renderer CSS beats the attribute
+        label.textContent = text;
