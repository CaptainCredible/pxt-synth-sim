+        g.addEventListener("pointerdown", (e: PointerEvent) => {
+            // keep the block from starting a drag and the dropdown from opening
+            e.stopPropagation();
+            e.preventDefault();
+            rect.setAttribute("fill-opacity", "0.6");
+            setTimeout(() => rect.setAttribute("fill-opacity", "0.9"), 150);
+            sendSynthPreview(this.sourceBlock_, this.message, note);
+        });
+    }
+}
+
+/** sends every number input and field value of the block, by name, to the simulator */
+function sendSynthPreview(block: Blockly.Block, message: string, note: number) {
+    if (!block) return;
+    const values: { [name: string]: number | string } = {};
+    for (const input of block.inputList) {
+        const target = input.connection?.targetBlock();
+        if (target) {
+            for (const fieldName of ["SLIDER", "NUM"]) {
+                const field = target.getField(fieldName);
+                if (field) {
+                    const v = parseFloat(field.getValue() as any);
+                    if (!isNaN(v)) values[input.name] = v;
+                    break;
+                }
+            }
+        }
+        for (const field of input.fieldRow) {
+            if (field.name && field.SERIALIZABLE) values[field.name] = String(field.getValue());
+        }
+    }
+    postSimulatorMessage({ type: "custom", content: { type: message, note, values } } as pxsim.SimulatorCustomMessage);
+}
