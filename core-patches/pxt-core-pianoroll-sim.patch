+        this.label(`${fmtMs(a + d + r)} + hold`, right, 10, "end", 0.7);
+    }
+
+    protected drawFilter(value: string, inputs: number[], w: number, h: number) {
+        const cutoff = clamp((inputs[0] ?? 100) / 100, 0, 1);
+        const reso = clamp((inputs[1] ?? 0) / 100, 0, 1);
+        // same mapping as MicroSynth: note 40..127 scaled so that note 69 = 700 Hz
+        const fc = 700 * Math.pow(2, (cutoff * 87 + 40 - 69) / 12);
