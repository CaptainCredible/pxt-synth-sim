+            this.drawButton(PREVIEW_BUTTON_WIDTH + PREVIEW_BUTTON_GAP, "high", this.previewNotes[1]);
+        }
+        const buttonHeight = 24;
+        const x = dropdownWidth + PREVIEW_BUTTON_GAP * 2;
+        this.buttonGroup.setAttribute("transform", `translate(${x}, ${(height - buttonHeight) / 2})`);
+
+        this.size_.width = x + PREVIEW_BUTTON_WIDTH * 2 + PREVIEW_BUTTON_GAP;
+    }
+
+    protected drawButton(x: number, text: string, note: number) {
+        const h = 24;
+        const g = Blockly.utils.dom.createSvgElement("g", { transform: `translate(${x}, 0)`, cursor: "pointer" }, this.buttonGroup);
+        const rect = Blockly.utils.dom.createSvgElement("rect", {
+            x: 0, y: 0, width: PREVIEW_BUTTON_WIDTH, height: h, rx: 4, ry: 4,
+            fill: "#ffffff", "fill-opacity": 0.9, stroke: "rgba(0,0,0,0.3)", "stroke-width": 1
+        }, g);
+        Blockly.utils.dom.createSvgElement("polygon", {
+            points: `8,${h / 2 - 5} 8,${h / 2 + 5} 16,${h / 2}`, fill: "#333333", "pointer-events": "none"
+        }, g);
