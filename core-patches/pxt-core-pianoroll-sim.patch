new file mode 100644
index 0000000..8b00bd1
--- /dev/null
+++ b/webapp/src/components/pianoRoll/sequenceTools.ts
@@ -0,0 +1,113 @@
+import { applyFloatingLayer, isDrumInstrument, NOTE_RANGES, NoteEvent, Song, Track, transposeFloatingLayer } from "./types";
+
+/**
+ * Whole-sequence edit tools for the piano roll footer, enabled with
+ *     //% song.fieldOptions.showSequenceTools=true
+ * All of them return a new song (or the same song when nothing can change).
+ */
+
+/** Remove every note from every track */
+export function clearSong(song: Song): Song {
+    return {
+        ...song,
+        floatingLayer: undefined,
+        tracks: song.tracks.map(t => ({ ...t, events: [] }))
+    };
+}
+
+/**
+ * Move notes up or down by semitones. If notes are selected only those move, otherwise
+ * every note on every melodic track. A track's visible octave range is widened to the
+ * smallest standard range that still shows all its notes; if no range fits, nothing changes.
+ */
+export function transposeSong(song: Song, semitones: number): Song {
+    if (!semitones) return song;
+    if (song.floatingLayer) return transposeFloatingLayer(song, semitones);
+
+    const tracks: Track[] = [];
+    for (const track of song.tracks) {
+        if (isDrumTrack(song, track) || !track.events.length) {
+            tracks.push(track);
+            continue;
+        }
+
+        const events = track.events.map(e => ({ ...e, note: e.note + semitones }));
+        const range = fitRange(track, events);
+        if (!range) return song;
+
+        tracks.push({ ...track, events, minOctave: range.minOctave, maxOctave: range.maxOctave });
+    }
+
+    return { ...song, tracks };
+}
+
+/**
+ * Move every note forwards or backwards in time by deltaTicks, wrapping around the end of
+ * the sequence. A note that would hang over the end after wrapping is shortened to fit.
+ */
+export function nudgeSong(song: Song, deltaTicks: number): Song {
+    if (!deltaTicks) return song;
+    song = applyFloatingLayer(song);
+
+    const totalTicks = song.measures * song.beatsPerMeasure * song.ticksPerBeat;
+    if (totalTicks <= 0) return song;
+
+    const tracks = song.tracks.map(track => {
+        const events: NoteEvent[] = track.events.map(e => {
+            const start = ((e.start + deltaTicks) % totalTicks + totalTicks) % totalTicks;
+            return { ...e, start, duration: Math.max(1, Math.min(e.duration, totalTicks - start)) };
+        });
+        // playback and the editor expect events in start order
+        events.sort((a, b) => a.start - b.start || a.note - b.note);
+        return { ...track, events };
+    });
+
+    return { ...song, tracks };
+}
+
+/**
+ * Merge every track into the first one (used with fieldOptions.singleTrack, where one
+ * song is one sequence with one sound). The first track keeps its instrument.
+ */
+export function mergeTracks(song: Song): Song {
+    if (song.tracks.length <= 1) return song;
+    song = applyFloatingLayer(song);
+
+    const first = song.tracks[0];
+    let nextId = 0;
+    const events: NoteEvent[] = [];
+    for (const track of song.tracks) {
+        if (track !== first && isDrumTrack(song, track)) continue;
+        for (const e of track.events) events.push({ ...e, id: nextId++ });
+    }
+    events.sort((a, b) => a.start - b.start || a.note - b.note);
+    const range = fitRange(first, events) || { minOctave: first.minOctave, maxOctave: first.maxOctave };
+
+    return {
+        ...song,
+        tracks: [{ ...first, events, nextId, minOctave: range.minOctave, maxOctave: range.maxOctave }]
+    };
+}
+
+function isDrumTrack(song: Song, track: Track) {
+    const instrument = song.instruments.find(i => i.id === track.instrumentId);
+    return !!instrument && isDrumInstrument(instrument);
+}
+
+function fitRange(track: Track, events: NoteEvent[]) {
+    if (!events.length) return { minOctave: track.minOctave, maxOctave: track.maxOctave };
+    let lowest = Infinity, highest = -Infinity;
+    for (const e of events) {
+        lowest = Math.min(lowest, e.note);
+        highest = Math.max(highest, e.note);
+    }
+    const fits = (min: number, max: number) => lowest >= min * 12 && highest <= (max + 1) * 12 - 1;
+
+    if (fits(track.minOctave, track.maxOctave)) return { minOctave: track.minOctave, maxOctave: track.maxOctave };
+
+    // smallest standard range that shows every note
+    const candidates = NOTE_RANGES
+        .filter(r => fits(r.minOctave, r.maxOctave))
+        .sort((a, b) => (a.maxOctave - a.minOctave) - (b.maxOctave - b.minOctave));
+    return candidates[0];
+}
