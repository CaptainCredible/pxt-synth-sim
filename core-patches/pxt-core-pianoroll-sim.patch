new file mode 100644
index 0000000..182fadc
--- /dev/null
+++ b/webapp/src/components/pianoRoll/simOutput.ts
@@ -0,0 +1,143 @@
+import * as simulator from "../../simulator";
+import { Instrument, isMelodicInstrument, Song } from "./types";
+
+/**
+ * "Simulator instruments": a piano roll field can declare
+ *     //% song.fieldOptions.simInstruments="Sound 1,Sound 2,Sound 3"
+ * to replace the built-in instruments (Dog, Duck, ...) with a list of
+ * instruments that only exist in the target's simulator (e.g. synth presets).
+ *
+ * Instrument i is stored in the song buffer with waveform SIM_INSTRUMENT_BASE + i,
+ * so the program can tell which one a track uses. All preview audio is then sent
+ * to the simulator iframe as a custom message instead of being played by pxsim.music:
+ *
+ *     { type: "custom", content: { type: "pianoroll-note", instrument, note, velocity, duration } }
+ *
+ * note is a MIDI note number (60 = middle C), velocity 0-127, duration in ms.
+ */
+
+export const SIM_INSTRUMENT_BASE = 200;
+export const SIM_NOTE_MESSAGE = "pianoroll-note";
+
+let simOutputEnabled = false;
+
+export function setSimOutputEnabled(enabled: boolean) {
+    simOutputEnabled = enabled;
+}
+
+export function isSimOutputEnabled() {
+    return simOutputEnabled;
+}
+
+export function createSimInstruments(names: string[]): Instrument[] {
+    return names.map((name, i) => ({
+        id: i,
+        name,
+        instrument: {
+            waveform: SIM_INSTRUMENT_BASE + i,
+            octave: 4,
+            ampEnvelope: {
+                attack: 10,
+                decay: 100,
+                sustain: 500,
+                release: 100,
+                amplitude: 1024
+            }
+        }
+    }));
+}
+
+/** index of the simulator instrument, or -1 if this isn't one */
+export function simInstrumentIndex(instrument: pxt.assets.music.Instrument | undefined): number {
+    if (!instrument) return -1;
+    const index = instrument.waveform - SIM_INSTRUMENT_BASE;
+    return index >= 0 && index < 50 ? index : -1;
+}
+
+/**
+ * Replace a song's instruments with the simulator instruments, mapping each
+ * track to the simulator instrument it was saved with (or the first one).
+ */
+export function applySimInstruments(song: Song, names: string[]): Song {
+    const instruments = createSimInstruments(names);
+
+    const alreadyApplied = song.instruments.length === instruments.length &&
+        song.instruments.every((inst, i) => inst.name === names[i] &&
+            isMelodicInstrument(inst) && simInstrumentIndex(inst.instrument) === i);
+    if (alreadyApplied) return song;
+
+    const tracks = song.tracks.map(track => {
+        const old = song.instruments.find(i => i.id === track.instrumentId);
+        let index = old && isMelodicInstrument(old) ? simInstrumentIndex(old.instrument) : -1;
+        if (index < 0 || index >= instruments.length) index = 0;
+        return { ...track, instrumentId: instruments[index].id };
+    });
+
+    return {
+        ...song,
+        instruments,
+        nextInstrumentId: instruments.length,
+        tracks
+    };
+}
+
+/**
+ * @param pianoRollNote the piano roll's 0-based note (0 = C1), not the 1-based pxt song note
+ */
+export function sendSimNote(instrumentIndex: number, pianoRollNote: number, velocity: number, durationMs: number) {
+    if (!simulator.driver) return;
+    simulator.proxy({
+        type: "custom",
+        content: {
+            type: SIM_NOTE_MESSAGE,
+            instrument: instrumentIndex,
+            note: pianoRollNote + 24,
+            velocity: Math.max(0, Math.min(127, Math.round(velocity))),
+            duration: Math.max(1, Math.round(durationMs))
+        }
+    } as pxsim.SimulatorCustomMessage);
+}
+
+// ---- song playback (Play / Loop buttons) ----
+
+let lastTick = -1;
+
+export function resetSimPlayback(startTick = 0) {
+    lastTick = startTick - 1;
+}
+
+/**
+ * Called on every sequencer tick while sim output is enabled. Sends every note
+ * that starts in (lastTick, tick], handling skipped ticks and loop wrap-around.
+ */
+export function onSimPlaybackTick(song: pxt.assets.music.Song, tick: number) {
+    if (!song) return;
+    const totalTicks = song.measures * song.beatsPerMeasure * song.ticksPerBeat;
+    const msPerTick = 60000 / song.beatsPerMinute / song.ticksPerBeat;
+
+    const sendRange = (from: number, to: number) => {
+        for (const track of song.tracks) {
+            const index = simInstrumentIndex(track.instrument);
+            if (track.drums || index < 0) continue;
+            for (const event of track.notes) {
+                if (event.startTick > from && event.startTick <= to) {
+                    const velocity = event.velocity === undefined ? 127 : Math.min(127, event.velocity);
+                    for (const note of event.notes) {
+                        // pxt song notes are 1-based
+                        sendSimNote(index, note.note - 1, velocity, (event.endTick - event.startTick) * msPerTick);
+                    }
+                }
+            }
+        }
+    };
+
+    if (tick < lastTick) {
+        // looped around
+        sendRange(lastTick, totalTicks);
+        sendRange(-1, tick);
+    }
+    else {
+        sendRange(lastTick, tick);
+    }
+    lastTick = tick;
+}
